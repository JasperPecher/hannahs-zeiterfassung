generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Matter {
  id      String   @id
  name    String
  slot    Int?     @unique
  entries Entry[]

  @@map("matters")
}

model Entry {
  id        String   @id
  matter_id String
  started   BigInt
  stopped   BigInt?
  note      String   @default("")

  matter    Matter   @relation(fields: [matter_id], references: [id], onDelete: Cascade)

  @@index([started])
  @@map("entries")
}

model AuthAttempt {
  id         Int    @id @default(1)
  expires_at BigInt
  attempts   Int

  @@map("auth_attempts")
}

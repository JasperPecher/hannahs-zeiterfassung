# Authentifizierung
AUTH_URL=http://127.0.0.1:3000
ZEITBUCH_TITLE="Hanners Zeiterfassung"
AUTH_SECRET=
ZEITBUCH_USERNAME=
ZEITBUCH_PASSWORD_HASH=

# PostgreSQL-Verbindung (z. B. Neon, Supabase oder lokales Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?sslmode=require"
# Optional für direkte Verbindung ohne Pooler
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/mydb?sslmode=require"
